{
  // This is the ROOT configuration, so it is what Codespaces uses when someone
  // creates a codespace without opening the options page -- the badge link, the
  // green "Create codespace" button, ?quickstart=1. With only named configs
  // under .devcontainer/<name>/, those paths silently fall back to the default
  // universal image and MMGIS never starts. The `dev` alternative still appears
  // in the "Dev container configuration" dropdown on the options page.
  "name": "MMGIS Demo (published image)",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  // 2-core / 8 GB is the smallest Codespaces machine and the cheapest against a
  // visitor's included quota. Only mmgis + db run, so it should fit.
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  },
  "containerEnv": {
    // Pin a tag here, and move it when the branch is rebased. This is the
    // dated `development` build of the upstream commit this branch sits on, so
    // the published image matches the scripts and docs next to it.
    //
    // Do not use `latest`: on ghcr.io it is still MMGIS 4.2.34, which predates
    // the Reference Mission and cannot seed it. Other useful tags: `5.2.24`
    // (last tagged release, legacy AUTH, works with these scripts) and
    // `development` (moves with upstream, untested here until you try it).
    // List them with:
    //   gh api /orgs/NASA-AMMOS/packages/container/mmgis/versions --jq '.[].metadata.container.tags[]'
    "MMGIS_IMAGE": "ghcr.io/nasa-ammos/mmgis:5.5.1-20261105-63003cd",
    // Which Reference Mission variant start.sh seeds. See
    // REFERENCE_MISSION_VARIANTS in plugins/core/backend/Utils/missionTemplates.js
    // for the keys: default (Earth), Lunar-SouthPole, Mars.
    "MMGIS_SEED_VARIANT": "default"
  },
  // NOTE: Codespaces prebuilds also run postCreateCommand, so anything secret
  // generated here would be baked into the prebuild and shared by every
  // codespace made from it. .env is written with an empty SECRET here; the
  // secret is generated at start time instead.
  "postCreateCommand": ".devcontainer/scripts/setup-env.sh",
  "postStartCommand": ".devcontainer/scripts/start.sh demo",
  "forwardPorts": [8888],
  "portsAttributes": {
    "8888": {
      "label": "MMGIS",
      "onAutoForward": "openBrowserOnce",
      "protocol": "http"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-azuretools.vscode-docker"]
    }
  }
}
